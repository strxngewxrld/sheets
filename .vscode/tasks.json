{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^(.+):(\\d+):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5 },
        "background": { "activeOnStart": true, "beginsPattern": "\\[watch\\] build started", "endsPattern": "\\[watch\\] build finished" }
      },
      "presentation": { "reveal": "silent" }
    },
    { "type": "npm", "script": "build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": "$tsc" },
    { "type": "npm", "script": "test", "group": "test", "problemMatcher": [] },
    { "type": "npm", "script": "package", "problemMatcher": [] },
    { "type": "shell", "command": "npm", "label": "Sheets: Publishing-Probelauf", "detail": "Tests, VSIX-Paketierung und GitHub-Package-Dry-Run ohne Upload", "args": ["run", "publish:github", "--", "--dry-run"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] }
  ]
}
